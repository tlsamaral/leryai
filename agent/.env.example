# Server
PORT=3334
HOST=0.0.0.0

# Gemini
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_TUTOR_MODEL=gemini-2.5-flash
GEMINI_EVALUATOR_MODEL=gemini-2.5-flash

# Lery API (used by agent to fetch context and persist logs)
LERY_API_URL=http://localhost:3333
# Device API key — used to authenticate to the iot/* routes during MVP testing.
# In production, agent will receive per-session credentials from each channel.
LERY_DEVICE_API_KEY=lery_replace_me

# Brain limits (passed to Tutor as constraints)
TUTOR_HARD_TIMEOUT_MS=10000
TUTOR_MAX_RETRIES=4
